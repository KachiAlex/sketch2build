# Database
DATABASE_URL=postgresql://user:password@host:5432/sketch2build
DB_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=

# Backend API internal wiring
AI_SERVICE_URL=http://ai:8000

# Cloudflare R2 Storage (S3-compatible)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<bucket-public-url>.r2.dev
R2_BUCKET=sketch2build
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# VLM sketch digitization (providers tried in order)
VLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
XAI_API_KEY=
GROK_MODEL=grok-4-fast-non-reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Transactional email (Brevo) — password reset links
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@sketch2build.com
APP_URL=https://sketch2build-web.vercel.app

# Frontend (Vite)
VITE_API_URL=/api
VITE_AI_URL=
