generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String
  role          String // architect | drafter | developer | homeowner | admin
  status        String        @default("active") // active | suspended
  organization  String?
  organizationId String?
  org           Organization? @relation(fields: [organizationId], references: [id])
  passwordHash  String
  projects      Project[]
  subscription  Subscription?
  resetTokens   PasswordResetToken[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String    @default("free") // free | pro | studio
  status    String    @default("active") // active | trialing | past_due | canceled
  seats     Int       @default(1)
  renewsAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id])
  name            String
  description     String?
  jurisdiction    String
  plotWidth       Float?
  plotDepth       Float?
  plotUnit        String?          // m | ft
  orientation     Float?
  status          String           @default("draft") // draft | processing | review | finalized
  generationJobs  GenerationJob[]
  editHistory     EditHistory[]
  exportRecords   ExportRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model GenerationJob {
  id               String      @id @default(uuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceType       String // sketch | prompt
  status           String      @default("queued") // queued | processing | candidates_ready | under_review | finalized | failed
  inputReference   String? // object storage key
  payload          Json?   // original generation input, retained for retries
  errorMessage     String?
  candidates       Candidate[]
  reviewedBy       String?
  reviewedAt       DateTime?
  finalizedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Candidate {
  id                  String       @id @default(uuid())
  jobId               String
  job                 GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rank                Int          @default(0)
  score               Float?
  scoreRationale      Json?
  geometryReference   String?
  complianceStatus    String       @default("pending") // pending | passed | failed
  planExtras          Json?        // plot dims, door openings, window openings
  rooms               Room[]
  complianceViolations ComplianceViolation[]
  createdAt           DateTime     @default(now())
}

model Room {
  id                String    @id @default(uuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type              String // living | bedroom | kitchen | bathroom | dining | corridor | entrance | store | other
  label             String?
  area              Float
  floor             Int       @default(1)
  boundaryGeometry  Json // array of [x, y] points
  adjacentRoomIds   String[]
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String // role_change | status_change | plan_change | user_delete | org_invite
  targetType String // user | organization | subscription
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ErrorLog {
  id         String   @id @default(uuid())
  method     String
  path       String
  statusCode Int
  message    String
  createdAt  DateTime @default(now())
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  ownerId   String
  members   User[]
  createdAt DateTime @default(now())
}

model ComplianceRule {
  id             String   @id @default(uuid())
  jurisdiction   String
  ruleType       String // setback | min_room_size | corridor_width | ventilation | etc.
  parameters     Json
  version        String
  effectiveDate  DateTime
  createdAt      DateTime @default(now())
}

model ComplianceViolation {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  ruleId      String
  message     String
  location    String?
  severity    String // error | warning
  createdAt   DateTime  @default(now())
}

model EditHistory {
  id                      String   @id @default(uuid())
  projectId               String
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  editorId                String
  changeDescription       String
  snapshot                Json?    // full previous candidate geometry state
  timestamp               DateTime @default(now())
  previousStateReference  String?
}

model ExportRecord {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  format         String // DXF | IFC | PDF | PNG
  fileReference  String
  exportedAt     DateTime @default(now())
}
